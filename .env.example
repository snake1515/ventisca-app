# Copia este archivo como .env solo si vas a probar en un computador
SECRET_KEY=cambia-esto-por-una-clave-larga
# Supabase > Connect > Session pooler (puerto 5432), con la contraseña real
DATABASE_URL=postgresql://postgres.xxxx:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Primera vez: así se crean la empresa y su administrador
NOMBRE_EMPRESA=Nombre de la empresa de aires
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
